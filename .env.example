# Shadlix workflow environment. Copy to `.env` (gitignored) and fill in.
# `.env` is read by scripts/shadlix-workflow.ps1; values already present in the
# process environment take precedence over this file.

# --- Tester PC (SSH) ---------------------------------------------------------
TESTER_SSH_USER=
TESTER_SSH_HOST=
# Optional, defaults to 22.
TESTER_SSH_PORT=22

# Authentication: set ONE of the two below. A key is preferred; run
#   ./scripts/shadlix-workflow.ps1 SetupSshKey
# once (uses the password a single time) to generate and install a dedicated
# key, after which the password can be removed from this file.
# Absolute path to an OpenSSH private key file.
TESTER_SSH_KEY=
# Plain password. Used non-interactively via SSH_ASKPASS; stored here in clear
# text, so prefer TESTER_SSH_KEY on anything but a trusted LAN.
TESTER_SSH_PASSWORD=

# --- Directories on the tester PC -------------------------------------------
# Where portable build zips are dropped by `Send`. Forward slashes; either an
# absolute Windows path (C:/Users/.../Downloads) or a path relative to the SSH
# user's home (Downloads).
TESTER_DEST_DIR_ROOT=Downloads
# Where the tester's report zips appear; `FetchReport` pulls the newest match
# from here and imports it into local-reports/ automatically.
TESTER_REPORT_DIR=Downloads
# Glob the report archives match (remote side, PowerShell/CMD wildcard).
TESTER_REPORT_GLOB=shadlix-*report*.zip
